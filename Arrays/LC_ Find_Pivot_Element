class Solution {
public:
    int pivotIndex(vector<int>& nums) {

        int n = nums.size();

        vector<int> v(n);

        v[0] = nums[0];

        for(int i = 1; i < n; i++){
            v[i] = v[i - 1] + nums[i];
        }

        int total_sum = v[n - 1];

        for(int i = 0; i < n; i++){

            int left_sum = 0;

            if(i == 0)
                left_sum = 0;
            else
                left_sum = v[i - 1];

            int right_sum = total_sum - v[i];

            if(left_sum == right_sum)
                return i;
        }

        return -1;
    }
};
